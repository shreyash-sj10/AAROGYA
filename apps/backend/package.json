{
  "name": "aarogya-backend",
  "version": "1.0.0",
  "private": true,
  "main": "src/modules/food/index.js",
  "type": "commonjs",
  "scripts": {
    "postinstall": "prisma generate",
    "lint": "eslint src scripts --max-warnings 50",
    "build": "node tests/testLLMHardValidation.js",
    "test:food": "node -e \"const { loadSampleFoods, getFoodsByCategory } = require('./src/modules/food'); console.log(loadSampleFoods().length); console.log(getFoodsByCategory('dal').length);\"",
    "test:candidate": "node tests/testCandidate.js && node tests/testCandidateGenerator.js",
    "test:rules": "node tests/testRules.js && node tests/testConstraintEngine.js",
    "test:scoring": "node tests/testScoring.js && node tests/testScoringEngine.js",
    "test:optimizer": "node tests/testOptimizer.js",
    "test:pipeline": "node tests/testPipeline.js && node tests/testIntegration.js",
    "test:determinism": "node tests/testDeterminism.js",
    "test:system": "node tests/testSystem.js && node tests/testSystemValidation.js",
    "test:all": "node tests/testFoodDB.js && node tests/testMealTemplate.js && node tests/testCandidate.js && node tests/testCandidateGenerator.js && node tests/testConstraintEngine.js && node tests/testRules.js && node tests/testScoring.js && node tests/testScoringEngine.js && node tests/testDiversityEngine.js && node tests/testOptimizer.js && node tests/testPipeline.js && node tests/testIntegration.js && node tests/testSystem.js && node tests/testUserState.js",
    "test:extended": "node scripts/run-extended-tests.js",
    "test:determinism-ci": "node scripts/run-determinism-ci.js",
    "test:p0-ci": "node scripts/run-p0-ci.js",
    "test:startup-contracts-ci": "node scripts/run-startup-contracts-ci.js",
    "test:phase1": "node scripts/run-phase1-ci.js",
    "golden-path-smoke": "node scripts/golden-path-smoke.js",
    "verify": "npm run lint && npm run build && npm run test:all && npm run test:extended && npm run test:phase1 && npm run golden-path-smoke",
    "test:llm": "node tests/testLLMHardValidation.js",
    "test:load": "node ../../infrastructure/scripts/loadtest.js",
    "test:ai-boundary": "node tests/testAIBoundary.js",
    "test:contracts": "node tests/testResponseContracts.js",
    "predev": "node scripts/free-listen-port.js",
    "dev": "nodemon src/server.js",
    "dev:kill-ports": "node scripts/free-listen-port.js",
    "start": "node scripts/migrate.js && node src/server.js",
    "test:daily-plan": "node tests/testDailyPlanApi.js",
    "test:llm-hard": "node tests/testLLMHardValidation.js"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "aarogya": "file:../..",
    "ajv": "^8.17.1",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "prisma": "^6.16.2",
    "redis": "^4.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.3.0",
    "globals": "^17.6.0",
    "nodemon": "^3.1.7"
  }
}
