{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "AssistantResponse_v1",
  "title": "AssistantResponse_v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "request_id",
    "trace_id",
    "trace",
    "data",
    "meta"
  ],
  "properties": {
    "version": {
      "type": "string",
      "const": "AssistantResponse_v1"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "trace_id": {
      "type": "string",
      "minLength": 1,
      "description": "Endpoint-level trace reference."
    },
    "trace": {
      "$ref": "Trace_v1"
    },
    "data": {
      "type": "object"
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "trace_id"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "trace_id": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
