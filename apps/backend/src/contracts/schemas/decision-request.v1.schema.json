{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "DecisionRequest_v1",
  "title": "DecisionRequest_v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "schema_version",
    "compatibility",
    "request_id",
    "trace_id",
    "user_state",
    "constraints",
    "meta"
  ],
  "properties": {
    "version": { "type": "string", "const": "DecisionRequest_v1" },
    "schema_version": { "type": "integer", "const": 1 },
    "compatibility": { "type": "string", "enum": ["backward"] },
    "request_id": { "type": "string", "minLength": 1 },
    "trace_id": { "type": "string", "minLength": 1 },
    "user_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "user_id",
        "goals",
        "risk_flags",
        "symptoms",
        "dosha_estimate",
        "allergies",
        "preferences",
        "context"
      ],
      "properties": {
        "user_id": { "type": "string", "minLength": 1 },
        "goals": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "risk_flags": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "symptoms": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "dosha_estimate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["vata", "pitta", "kapha"],
          "properties": {
            "vata": { "type": "number", "minimum": 0, "maximum": 1 },
            "pitta": { "type": "number", "minimum": 0, "maximum": 1 },
            "kapha": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "allergies": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "preferences": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "context": {
          "type": "object",
          "additionalProperties": false,
          "required": ["meal_type", "season"],
          "properties": {
            "meal_type": { "type": "string", "enum": ["breakfast", "lunch", "dinner"] },
            "season": { "type": "string", "enum": ["summer", "winter", "monsoon"] }
          }
        }
      }
    },
    "user_history": {
      "anyOf": [
        { "type": "object" },
        { "type": "array", "items": { "type": "object" } }
      ]
    },    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_calories", "diet_type"],
      "properties": {
        "max_calories": { "type": "number", "minimum": 0 },
        "diet_type": { "type": "string", "enum": ["vegetarian", "vegan"] }
      }
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timestamp", "request_source", "cache_allowed"],
      "properties": {
        "timestamp": { "type": "integer", "minimum": 0 },
        "request_source": { "type": "string", "minLength": 1 },
        "cache_allowed": { "type": "boolean" }
      }
    }
  }
}


