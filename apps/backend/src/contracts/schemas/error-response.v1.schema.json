{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ErrorResponse_v1",
  "title": "ErrorResponse_v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "request_id",
    "trace_id",
    "trace",
    "error"
  ],
  "properties": {
    "version": {
      "type": "string",
      "const": "ErrorResponse_v1"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "trace_id": {
      "type": "string",
      "minLength": 1
    },
    "trace": {
      "$ref": "Trace_v1"
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "details"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "details": {
          "type": "object"
        }
      }
    }
  }
}
