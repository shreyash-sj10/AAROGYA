{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "MLInterpretation_v1",
  "title": "MLInterpretation_v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["prakriti_inference", "confidence", "signals"],
  "properties": {
    "prakriti_inference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vata", "pitta", "kapha"],
      "properties": {
        "vata": { "type": "number", "minimum": 0, "maximum": 1 },
        "pitta": { "type": "number", "minimum": 0, "maximum": 1 },
        "kapha": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "signals": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
