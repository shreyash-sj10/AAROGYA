{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "Trace_v1",
  "title": "Trace_v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "schema_version", "compatibility", "trace_id", "timestamp", "stages"],
  "properties": {
    "version": { "type": "string", "const": "Trace_v1" },
    "schema_version": { "type": "integer", "const": 1 },
    "compatibility": { "type": "string", "enum": ["backward"] },
    "trace_id": { "type": "string", "minLength": 1 },
    "timestamp": { "type": "integer", "minimum": 0 },
    "refinement_loop": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "round": { "type": "integer", "minimum": 0 },
        "triggered_questions": { "type": "array", "items": { "type": "string" } },
        "reason": { "type": "string" },
        "impact_on_confidence": { "type": "number" }
      }
    },
    "stages": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_generator",
        "interpretation_layer",
        "constraint_engine",
        "scoring_engine",
        "diversity_engine",
        "optimizer",
        "reliability_engine"
      ],
      "properties": {
        "interpretation_layer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ml_used", "ml_confidence", "ml_contribution_weight"],
          "properties": {
            "ml_used": { "type": "boolean" },
            "ml_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
            "ml_contribution_weight": { "type": "number", "minimum": 0, "maximum": 0.4 }
          }
        },
        "candidate_generator": {
          "type": "object",
          "additionalProperties": false,
          "required": ["input_count", "output_count"],
          "properties": {
            "input_count": { "type": "integer", "minimum": 0 },
            "output_count": { "type": "integer", "minimum": 0 }
          }
        },
        "constraint_engine": {
          "type": "object",
          "additionalProperties": false,
          "required": ["input_count", "output_count", "rejected", "rules", "p0_rules_checked", "p0_violations", "p0_violated_rule_ids"],
          "properties": {
            "input_count": { "type": "integer", "minimum": 0 },
            "output_count": { "type": "integer", "minimum": 0 },
            "rejected": { "type": "integer", "minimum": 0 },
            "rules": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["rule_id", "action", "reason"],
                "properties": {
                  "rule_id": { "type": "string", "minLength": 1 },
                  "action": { "type": "string", "enum": ["reject", "penalize"] },
                  "reason": { "type": "string", "minLength": 1 }
                }
              }
            },
            "p0_rules_checked": { "type": "integer", "minimum": 0 },
            "p0_violations": { "type": "integer", "minimum": 0 },
            "p0_violated_rule_ids": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            }
          }
        },
        "scoring_engine": {
          "type": "object",
          "additionalProperties": false,
          "required": ["input_count", "output_count"],
          "properties": {
            "input_count": { "type": "integer", "minimum": 0 },
            "output_count": { "type": "integer", "minimum": 0 }
          }
        },
        "diversity_engine": {
          "type": "object",
          "additionalProperties": false,
          "required": ["input_count", "output_count"],
          "properties": {
            "input_count": { "type": "integer", "minimum": 0 },
            "output_count": { "type": "integer", "minimum": 0 },
            "historical_matches_count": { "type": "integer", "minimum": 0 },
            "diversity_penalty_applied": { "type": "number", "minimum": 0 }
          }
        },
        "optimizer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["input_count", "output_count", "combinations_evaluated", "selected_score"],
          "properties": {
            "input_count": { "type": "integer", "minimum": 0 },
            "output_count": { "type": "integer", "minimum": 0 },
            "combinations_evaluated": { "type": "integer", "minimum": 0 },
            "selected_score": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "reliability_engine": {
          "type": "object",
          "additionalProperties": false,
          "required": ["input_count", "output_count"],
          "properties": {
            "input_count": { "type": "integer", "minimum": 0 },
            "output_count": { "type": "integer", "minimum": 0 },
            "relaxation_level": { "type": "integer", "minimum": 0, "maximum": 4 },
            "relaxed_priorities": {
              "type": "array",
              "items": { "type": "string" }
            },
            "confidence_eval": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "relaxation_impact",
                "pool_quality",
                "score_confidence",
                "penalty_impact",
                "diversity_impact"
              ],
              "properties": {
                "relaxation_impact": { "type": "number", "minimum": 0, "maximum": 1 },
                "pool_quality": { "type": "number", "minimum": 0, "maximum": 1 },
                "score_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
                "penalty_impact": { "type": "number", "minimum": 0, "maximum": 1 },
                "diversity_impact": { "type": "number", "minimum": 0, "maximum": 1 }
              }
            }
          }
        }
      }
    },
    "execution": { "type": "object" },
    "safe": { "type": "object" }
  }
}
