{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "WeeklyDecisionRequest_v1",
  "title": "WeeklyDecisionRequest_v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "schema_version",
    "compatibility",
    "user_id",
    "goals",
    "risk_flags",
    "symptoms",
    "dosha_profile",
    "allergies",
    "preferences",
    "constraints",
    "meta"
  ],
  "properties": {
    "version": { "type": "string", "const": "WeeklyDecisionRequest_v1" },
    "schema_version": { "type": "integer", "const": 1 },
    "compatibility": { "type": "string", "enum": ["backward"] },
    "user_id": { "type": "string", "minLength": 1 },
    "goals": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "risk_flags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "symptoms": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "dosha_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vata", "pitta", "kapha"],
      "properties": {
        "vata": { "type": "number", "minimum": 0 },
        "pitta": { "type": "number", "minimum": 0 },
        "kapha": { "type": "number", "minimum": 0 }
      }
    },
    "allergies": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "preferences": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "week_context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "days": { "type": "integer", "minimum": 1, "maximum": 7, "default": 7 },
        "start_date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_calories": { "type": "number", "minimum": 0 },
        "diet_type": { "type": "string", "enum": ["vegetarian", "vegan"] },
        "season": { "type": "string", "enum": ["summer", "winter", "monsoon"] }
      }
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timestamp", "request_source", "cache_allowed"],
      "properties": {
        "timestamp": { "type": "integer", "minimum": 0 },
        "request_source": { "type": "string", "minLength": 1 },
        "cache_allowed": { "type": "boolean" },
        "request_id": { "type": "string", "minLength": 1 },
        "trace_id": { "type": "string", "minLength": 1 }
      }
    }
  }
}
